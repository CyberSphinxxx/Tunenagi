# Android / IDE
.gradle/
.idea/
*.iml
build/
**/build/
local.properties
.cxx/
.externalNativeBuild/
.captures/
*.apk
*.aab

# Secrets / signing
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pem
*.key
*.secrets
secrets.properties

# Raw local diagnostic evidence (can include device paths or API responses)
STATE/evidence/**
!STATE/evidence/.gitkeep
STATE/driver_runs/**
!STATE/driver_runs/.gitkeep

# Python and editor temporary
__pycache__/
*.pyc
.kotlin/

# Local Gradle distribution downloads and crash diagnostics.
# gradle-8.11.1-bin.zip was left at the kit root by an earlier session and is a 130 MB
# download artefact, not a build input; heap dumps come from the JVM args in
# gradle.properties. Both must never be committed.
gradle-*-bin.zip
*.hprof
*.log

# Gradle/Kotlin local build state left at the kit root by earlier sessions.
.gradle-native/
.DS_Store
Thumbs.db
*.swp
.tmp/

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build
