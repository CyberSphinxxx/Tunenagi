<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Tunenagi</string>

    <!-- Navigation -->
    <string name="tab_home">Home</string>
    <string name="tab_search">Search</string>
    <string name="tab_library">Library</string>
    <string name="action_open_search">Search</string>

    <!-- Home -->
    <string name="import_music">Import music</string>
    <string name="import_reading_folder">Reading that folder…</string>
    <plurals name="import_songs_ready">
        <item quantity="one">%1$d song ready to play</item>
        <item quantity="other">%1$d songs ready to play</item>
    </plurals>
    <string name="import_no_audio">No audio this app can play in that folder.</string>
    <string name="import_permission_required">Access to that folder was revoked. Pick it again to restore it.</string>
    <string name="import_failed">That folder could not be read. Try another folder.</string>
    <string name="home_empty_title">Nothing here yet</string>
    <string name="home_empty_message">Songs you play and save will show up here. Search your device and your sources to get started.</string>

    <!-- Search -->
    <string name="search_title">Search</string>
    <string name="search_label">Search</string>
    <string name="search_hint">Songs, artists, albums</string>
    <string name="search_empty_title">Search your music</string>
    <string name="search_empty_message">Search will cover music on your device and any sources you add.</string>

    <!-- Remote discovery (Audius). Each state says what is happening, not just that something is,
         so a trend page that came back empty never looks like a silent failure. -->
    <string name="browse_audius_title">Browse Audius</string>
    <string name="browse_audius_start">Browse</string>
    <string name="browse_audius_loading">Loading Audius trending…</string>
    <string name="remote_retry">Retry</string>
    <string name="search_audius_loading">Searching Audius…</string>
    <string name="search_empty_results">Audius has no results for that search.</string>

    <!-- Library -->
    <string name="library_empty_title">Your library is empty</string>
    <string name="library_empty_message">Songs you import or save will appear here.</string>

    <!-- Player -->
    <string name="player_title">Now playing</string>
    <string name="player_close">Close player</string>
    <string name="player_empty_title">Nothing is playing</string>
    <string name="player_empty_message">Choose a track from Home, Search or your Library to start playback.</string>

    <!-- Mini-player transport. The labels are the accessible names of the controls, so they
         describe the action the control performs, not the current state. -->
    <string name="mini_player_play">Play</string>
    <string name="mini_player_pause">Pause</string>

    <!-- Playback problems. Each message says what happened in terms a listener can act on; the
         Retry control is the accessible name of the retry action. -->
    <string name="playback_buffering">Buffering…</string>
    <string name="playback_retry">Retry</string>
    <string name="playback_error_timeout">Playback timed out. Try again.</string>
    <string name="playback_error_network">Can\'t reach the source. Check your connection.</string>
    <string name="playback_error_missing">This track is no longer on this device.</string>
    <string name="playback_error_permission">Access to this track was revoked.</string>
    <string name="playback_error_unsupported">This device can\'t play this file.</string>
    <string name="playback_error_unknown">Playback stopped unexpectedly.</string>
</resources>
